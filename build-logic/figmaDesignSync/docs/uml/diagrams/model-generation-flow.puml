@startuml figma-design-sync-model-generation-flow
!include ../../../../../docs/uml/includes/theme.puml
!include ../../../../../docs/uml/includes/stereotypes.puml

title figmaDesignSync model generation flow

actor "Gradle" as gradle <<gradle>>
participant "GenerateFigmaDesignModelTask" as task <<gradle>>
participant "FigmaDesignModelGenerator" as generator <<gradle>>
participant "RepositoryVersionsPort" as versionsPort <<port>>
participant "ProjectCatalogTreesPort" as catalogPort <<port>>
participant "ProjectModulesPort" as modulesPort <<port>>
participant "ProjectModuleDependenciesPort" as moduleDependenciesPort <<port>>
participant "FigmaDesignModelHash" as hash <<gradle>>
database "design-model.json" as designModel <<artifact>>

note over gradle, designModel
This task does not update Figma directly.
It turns repository sources into a deterministic
design-model.json snapshot that later sync steps
can publish to Figma and verify against main.
end note

gradle -> task : run generateFigmaDesignModel
activate task

task -> task : read branch and gitSha\nfrom git
task -> generator : generate(request)
activate generator

generator -> versionsPort : readVersionSections(versionsFile)
versionsPort --> generator : repository version sections

generator -> catalogPort : read Water My Plants\nlibrary and plugin trees
catalogPort --> generator : catalog trees

generator -> catalogPort : read build-logic\nlibrary and plugin trees
catalogPort --> generator : build-logic catalog trees

generator -> catalogPort : read custom Gradle plugin trees
catalogPort --> generator : custom plugin trees

generator -> modulesPort : readModules(root settings,\nbuild-logic settings)
modulesPort --> generator : sorted module names

generator -> moduleDependenciesPort : readModuleDependencies(main)
moduleDependenciesPort --> generator : main dependency graph

generator -> moduleDependenciesPort : readModuleDependencies(buildLogic)
moduleDependenciesPort --> generator : build-logic dependency graph

generator -> generator : build stable content JSON
generator -> hash : compute(schemaVersion,\nbranch, gitSha, content)
hash --> generator : modelHash

generator --> task : model and modelHash
deactivate generator

task -> designModel : write pretty JSON with generatedAt
task --> gradle : report output path and modelHash
deactivate task

note right of hash
generatedAt is written to the model,
but excluded from the hash input.
end note

@enduml
