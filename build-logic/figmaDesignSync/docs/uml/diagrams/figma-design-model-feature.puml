@startuml figma-design-sync-figma-design-model-feature
!include ../../../../../docs/uml/includes/theme.puml
!include ../../../../../docs/uml/includes/stereotypes.puml

title figma-design-model.feature

skinparam activity {
  BackgroundColor #FFFFFF
  BackgroundColor<<scenario>> #EFF6FF
  BorderColor #475569
  FontColor #0F172A
  StartColor #059669
  EndColor #059669
  DiamondBackgroundColor #EFF6FF
  DiamondBorderColor #2563EB
}
skinparam partition {
  BorderColor #94A3B8
  BackgroundColor #F8FAFC
}
skinparam nodesep 70
skinparam ranksep 90

start

:Feature\nFigma design model generation;

:Background\nRepository versions are available\nRepository catalog trees are available\nRepository project modules are available\nRepository module dependencies are available;

fork
  partition "@domain" {
    :<b>Scenario</b>\nGenerate the dependency design model; <<scenario>>
    :When the design model is generated\nat 2026-06-19T10:15:30Z;
    :Then the model contains repository metadata;
    :And content contains versions,\nversionSections, catalogs,\nmodules, and moduleDependencies;
    :And version keys and sections\nkeep deterministic order;
    :And the model hash is stored\nin the generated model;
  }
fork again
  partition "@domain" {
    :<b>Scenario</b>\ngeneratedAt does not affect the model hash; <<scenario>>
    :When the design model is generated\nat 2026-06-19T10:15:30Z;
    :And the design model is generated again\nat 2026-06-19T10:16:30Z;
    :Then both generated model hashes\nare equal;
  }
fork again
  partition "@domain" {
    :<b>Scenario</b>\ngitSha affects the model hash; <<scenario>>
    :When the design model is generated\nfor git sha abc123;
    :And the design model is generated again\nfor git sha def456;
    :Then both generated model hashes\nare different;
  }
fork again
  partition "@gradle @integration" {
    :<b>Scenario</b>\ngenerateFigmaDesignModel writes\nthe design model report; <<scenario>>
    :Given a temporary Gradle project exists;
    :And it has repository model files,\napplies the plugin, and is a git repository;
    :When generateFigmaDesignModel runs\nin the temporary project;
    :Then design-model.json is written;
    :And it contains branch, git sha,\ncontent, and modelHash;
  }
end fork

:Executable contract for the generated\ndesign-model.json artifact;

stop

@enduml
