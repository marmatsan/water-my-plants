{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@figma/plugin-typings"],
    "strict": false,
    "noEmit": true,
    "noEmitOnError": true,
    "removeComments": false
  },
  "include": ["src/**/*.ts"]
}
