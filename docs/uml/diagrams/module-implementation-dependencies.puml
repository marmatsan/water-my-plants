@startuml module-implementation-dependencies
!include ../includes/theme.puml
!include ../includes/stereotypes.puml

title Module implementation(projects...) consumers

top to bottom direction

skinparam nodesep 70
skinparam ranksep 100
skinparam packageStyle rectangle

legend top
  Sections are ordered alphabetically by target module path in source.
  Each section contains one target module and the modules that declare
  implementation(projects...) against it.
  Arrows represent implementation(projects...) dependencies.
endlegend

package "module :core:ui" as ModuleCoreUi {
  component ":app" as AppConsumesCore
  component ":onboarding:ui" as OnboardingConsumesCore
  component ":core:ui" as CoreUiTarget

  AppConsumesCore --> CoreUiTarget
  OnboardingConsumesCore --> CoreUiTarget
}

package "included build dependency-catalog module :catalog-core" as ModuleCatalogCore {
  component ":dependency-catalog:water-my-plants-catalog" as WaterMyPlantsCatalogConsumesCore <<gradle>>
  component ":dependency-catalog:catalog-core" as CatalogCoreTarget <<domain>>

  WaterMyPlantsCatalogConsumesCore --> CatalogCoreTarget
}

package "module :dependencies" as ModuleDependencies {
  component ":android" as AndroidConsumesDependencies <<gradle>>
  component ":bdd-test" as BddTestConsumesDependencies <<gradle>>
  component ":compose" as ComposeConsumesDependencies <<gradle>>
  component ":protobuf" as ProtobufConsumesDependencies <<gradle>>
  component ":unit-test" as UnitTestConsumesDependencies <<gradle>>
  component ":dependencies" as DependenciesTarget <<gradle>>

  AndroidConsumesDependencies --> DependenciesTarget
  BddTestConsumesDependencies --> DependenciesTarget
  ComposeConsumesDependencies --> DependenciesTarget
  ProtobufConsumesDependencies --> DependenciesTarget
  UnitTestConsumesDependencies --> DependenciesTarget
}

package "included build figma-documentation-sync module :data" as ModuleFigmaDocumentationSyncData {
  component ":figma-documentation-sync:plugin" as FigmaPluginConsumesData <<gradle>>
  component ":figma-documentation-sync:data" as FigmaDataTarget <<adapter>>

  FigmaPluginConsumesData --> FigmaDataTarget
}

package "included build figma-documentation-sync module :domain" as ModuleFigmaDocumentationSyncDomain {
  component ":figma-documentation-sync:data" as FigmaDataConsumesDomain <<adapter>>
  component ":figma-documentation-sync:plugin" as FigmaPluginConsumesDomain <<gradle>>
  component ":figma-documentation-sync:domain" as FigmaDomainTarget <<domain>>

  FigmaDataConsumesDomain --> FigmaDomainTarget
  FigmaPluginConsumesDomain --> FigmaDomainTarget
}

package "modules without incoming implementation(projects...) consumers" as ModuleNoIncomingConsumers {
  component ":android" as AndroidTarget <<gradle>>
  component ":app" as AppTarget
  component ":bdd-test" as BddTestTarget <<gradle>>
  component ":compose" as ComposeTarget <<gradle>>
  component ":dokka-documentation" as DokkaDocumentationTarget <<gradle>>
  component ":figma-documentation-sync:plugin" as FigmaPluginTarget <<gradle>>
  component ":onboarding:ui" as OnboardingTarget
  component ":protobuf" as ProtobufTarget <<gradle>>
  component ":unit-test" as UnitTestTarget <<gradle>>
  component ":dependency-catalog:water-my-plants-catalog" as WaterMyPlantsCatalogTarget <<gradle>>
}

ModuleCoreUi -[hidden]down-> ModuleCatalogCore
ModuleCatalogCore -[hidden]down-> ModuleDependencies
ModuleDependencies -[hidden]down-> ModuleFigmaDocumentationSyncData
ModuleFigmaDocumentationSyncData -[hidden]down-> ModuleFigmaDocumentationSyncDomain
ModuleFigmaDocumentationSyncDomain -[hidden]down-> ModuleNoIncomingConsumers

@enduml
