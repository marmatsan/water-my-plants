{
  "schemaVersion": 1,
  "documentationOnlyPaths": [
    "README.md",
    "AGENTS.md",
    "docs/*.md",
    "*/docs/*.md",
    "*/*/docs/*.md",
    "*/AGENTS.md",
    "*/*/AGENTS.md",
    ".teamcity/README.md",
    "repo/*/README.md",
    "repo/*/docs/*.md"
  ],
  "figmaTransportOnlyPaths": [
    "repo/figma-design-sync/tools/scripts/payload-png.ts",
    "repo/figma-design-sync/tools/scripts/write-mcp-runner.ts",
    "repo/figma-design-sync/tools/scripts/execute-mcp-runner.ts",
    "repo/figma-design-sync/tools/scripts/write-visual-sync-plan.ts",
    "repo/figma-design-sync/tools/tests/*"
  ],
  "figmaModelNeutralPaths": [
    ".teamcity/documentation-coverage.json",
    ".teamcity/scripts/invoke-ci-verification.ps1",
    ".teamcity/scripts/validate-documentation.ps1",
    ".teamcity/scripts/tests/*",
    "repo/figma-design-sync/change-impact-policy.json",
    "repo/figma-design-sync/domain/src/main/kotlin/com/marmatsan/figmaDesignSync/domain/model/impact/*",
    "repo/figma-design-sync/domain/src/main/kotlin/com/marmatsan/figmaDesignSync/domain/port/impact/*",
    "repo/figma-design-sync/data/src/main/kotlin/com/marmatsan/figmaDesignSync/data/datasource/impact/*",
    "repo/figma-design-sync/plugin/src/main/kotlin/com/marmatsan/figmaDesignSync/plugin/checker/impact/*",
    "repo/figma-design-sync/plugin/src/main/kotlin/com/marmatsan/figmaDesignSync/plugin/task/impact/*",
    "repo/figma-design-sync/plugin/src/test/kotlin/com/marmatsan/figmaDesignSync/plugin/checker/impact/*"
  ],
  "figmaModelContentPaths": [
    ".teamcity/settings.kts",
    "docs/ci/*.yaml",
    "repo/dependency-catalog/*",
    "repo/gradle-plugins/settings.gradle.kts",
    "repo/figma-design-sync/settings.gradle.kts",
    "settings.gradle.kts",
    "build.gradle.kts",
    "*/build.gradle.kts",
    "*/*/build.gradle.kts"
  ],
  "figmaVisualWriterPaths": [
    "repo/figma-design-sync/tools/src/*"
  ],
  "figmaVisualTargetRules": [
    {
      "paths": ["repo/figma-design-sync/tools/src/figma/figma-version-*", "repo/figma-design-sync/tools/src/domain/version/*"],
      "targets": ["versions"]
    },
    {
      "paths": ["repo/figma-design-sync/tools/src/figma/figma-header-*", "repo/figma-design-sync/tools/src/domain/header/*"],
      "targets": ["headers"]
    },
    {
      "paths": ["repo/figma-design-sync/tools/src/figma/figma-ci-*", "repo/figma-design-sync/tools/src/domain/ci/*"],
      "targets": ["ci.overview", "ci.pullRequestIntegration", "ci.postMergeDesignDocumentation", "ci.infrastructureAndAccess", "ci.windowsRuntime"]
    },
    {
      "paths": ["repo/figma-design-sync/tools/src/figma/figma-catalog-*", "repo/figma-design-sync/tools/src/domain/catalog/*"],
      "targets": ["waterMyPlants.libraries", "waterMyPlants.plugins", "waterMyPlants.customGradleConventionPlugins", "waterMyPlants.customGradlePlugins", "gradlePlugins.libraries", "gradlePlugins.plugins", "figmaDesignSync.libraries", "figmaDesignSync.plugins"]
    }
  ]
}
