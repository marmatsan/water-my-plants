{
  "name": "@marmatsan/figma-design-sync-tools",
  "version": "0.1.0-SNAPSHOT",
  "description": "Portable TypeScript Figma Plugin API boundary for Figma Design Sync.",
  "private": true,
  "type": "module",
  "bin": {
    "figma-design-sync-build": "bin/build.mjs"
  },
  "files": [
    "bin/",
    "fixtures/",
    "scripts/",
    "src/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node bin/build.mjs --output-dir=.",
    "test": "node tests/test.mjs",
    "premcp:runner": "npm run build",
    "mcp:runner": "node dist/write-mcp-runner.mjs",
    "premcp:preview": "npm run build",
    "mcp:preview": "node dist/write-mcp-runner.mjs --mode=preview"
  },
  "dependencies": {
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.117.0",
    "typescript": "^5.8.3"
  }
}
