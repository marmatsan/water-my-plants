{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@figma-design-sync/project-config": ["../project-config/water-my-plants/figma-config.ts"]
    },
    "lib": ["ES2022"],
    "types": ["@figma/plugin-typings"],
    "strict": false,
    "noEmit": true,
    "noEmitOnError": true,
    "removeComments": false
  },
  "include": ["src/**/*.ts"]
}
